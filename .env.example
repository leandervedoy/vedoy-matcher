SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_app_proxy
# 32 cryptographically random bytes, base64 encoded. Never reuse the Shopify secret.
SESSION_ENCRYPTION_KEY=
# Local development only. Use a persistent encrypted volume for a single-instance pilot.
DATABASE_URL=file:./dev.sqlite
# Supabase production alternative: see docs/supabase.md. Generate the Postgres client first.
# DATABASE_URL=postgresql://USER:PASSWORD@EXACT_CONNECT_HOST:6543/postgres?schema=matcher&sslmode=require&pgbouncer=true&connection_limit=3
# DIRECT_URL=postgresql://USER:PASSWORD@EXACT_CONNECT_HOST:5432/postgres?schema=matcher&sslmode=require
# Never enable the local preview route in production.
ALLOW_LOCAL_PREVIEW=false
